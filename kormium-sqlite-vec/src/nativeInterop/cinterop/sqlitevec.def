package = csqlitevec

# The whole native half of this package: three lines of C, compiled into cinterop's own stubs.
#
# libsqlitevec.a holds only sqlite-vec (built with -DSQLITE_CORE); its sqlite3_* references stay
# unresolved and are satisfied at final link from the libsqlite3.a embedded in kormium-sqlite's
# cinterop klib. Registering the entry point with sqlite3_auto_extension applies it to every
# connection opened afterwards, which is how the whole pool gets it at once.
---
#include "sqlite3.h"

int sqlite3_vec_init(sqlite3*, char**, const void*);

static int kormium_register_sqlite_vec(void) {
    return sqlite3_auto_extension((void(*)(void)) sqlite3_vec_init);
}
